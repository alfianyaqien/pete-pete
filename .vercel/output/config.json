{
  "version": 3,
  "overrides": {},
  "routes": [
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "src": "/_nuxt/builds/meta/(.*)"
    },
    {
      "headers": {
        "cache-control": "public, max-age=1, immutable"
      },
      "src": "/_nuxt/builds/(.*)"
    },
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "src": "/_fonts/(.*)"
    },
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "src": "/_nuxt/(.*)"
    },
    {
      "src": "/_nuxt/builds/meta(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "src": "/_nuxt/builds(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "src": "/_fonts(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "src": "/_nuxt(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "(?<__isr_route>/__nuxt_error)",
      "dest": "/__fallback"
    },
    {
      "src": "/bill/new",
      "dest": "/bill/new"
    },
    {
      "src": "/badges",
      "dest": "/badges"
    },
    {
      "src": "/api/bills",
      "dest": "/api/bills"
    },
    {
      "src": "/__nuxt_error",
      "dest": "/__nuxt_error"
    },
    {
      "src": "/",
      "dest": "/index"
    },
    {
      "src": "/bill/(?<id>[^/]+)/settle",
      "dest": "/bill/[id]/settle"
    },
    {
      "src": "/bill/(?<id>[^/]+)/participants",
      "dest": "/bill/[id]/participants"
    },
    {
      "src": "/bill/(?<id>[^/]+)/export/pdf",
      "dest": "/bill/[id]/export/pdf"
    },
    {
      "src": "/bill/(?<id>[^/]+)/export/image",
      "dest": "/bill/[id]/export/image"
    },
    {
      "src": "/bill/(?<id>[^/]+)/add",
      "dest": "/bill/[id]/add"
    },
    {
      "src": "/bill/(?<id>[^/]+)",
      "dest": "/bill/[id]"
    },
    {
      "src": "/api/bills/(?<id>[^/]+)/participants/(?<pid>[^/]+)",
      "dest": "/api/bills/[id]/participants/[pid]"
    },
    {
      "src": "/api/bills/(?<id>[^/]+)/participants",
      "dest": "/api/bills/[id]/participants"
    },
    {
      "src": "/api/bills/(?<id>[^/]+)/entries/(?<eid>[^/]+)",
      "dest": "/api/bills/[id]/entries/[eid]"
    },
    {
      "src": "/api/bills/(?<id>[^/]+)/entries",
      "dest": "/api/bills/[id]/entries"
    },
    {
      "src": "/api/bills/(?<id>[^/]+)",
      "dest": "/api/bills/[id]"
    },
    {
      "src": "/__nuxt_island/(?:.*)",
      "dest": "/__nuxt_island/[...]"
    },
    {
      "src": "/(.*)",
      "dest": "/__fallback"
    }
  ]
}