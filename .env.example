# PetePete — server-only secrets. Copy to .env and fill in.
# These are read ONLY by Nitro server routes (server/**), never by the client.
# In Nuxt, runtimeConfig.supabaseUrl <- NUXT_SUPABASE_URL (env wins in production).

# Supabase project REST URL, e.g. https://xxxxxxxx.supabase.co
NUXT_SUPABASE_URL=

# Supabase SERVICE ROLE key (server-side only — never expose to the browser)
NUXT_SUPABASE_SERVICE_KEY=
